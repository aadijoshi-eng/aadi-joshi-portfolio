{
  "name": "aadi-joshi-portfolio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build --webpack && node scripts/prepare-github-pages.mjs",
    "build:github-pages": "npm run build && npm run validate",
    "start": "node scripts/serve.mjs",
    "test": "npm run build:github-pages && node --test tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "data": "python3 scripts/build_atlas_data.py",
    "validate": "node scripts/validate-github-pages.mjs"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "shapefile": "^0.6.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module",
  "displayName": "Aadi Joshi Research & Analysis Portfolio",
  "overrides": {
    "baseline-browser-mapping": "^2.11.0",
    "source-map-js": "^1.2.2"
  }
}
